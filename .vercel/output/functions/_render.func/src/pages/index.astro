---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import StudiesSection from "../components/StudiesSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import CertificatesSection from "../components/CertificatesSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import TechnologiesSection from "../components/TechnologiesSection.astro";
import ContactSection from "../components/ContactSection.astro";
import { HomePageSchema } from "../types";
import { CACHE_CONFIG } from "../constants";

// Configurar caché corto para actualizaciones rápidas
Astro.response.headers.set("Cache-Control", CACHE_CONFIG.short);

// Fetch data from WordPress (con manejo de errores)
let parsedData = null;
let title = "";

try {
  const url = `${import.meta.env.API_URL}/pages?slug=inicio`;
  const response = await fetch(url);

  if (response.ok && response.headers.get('content-type')?.includes('application/json')) {
    const json = await response.json();

    if (json && json.length > 0) {
      parsedData = HomePageSchema.parse(json[0]);
      title = parsedData.title.rendered;
    }
  }
} catch (error) {
  console.log('WordPress API no disponible, usando valores por defecto');
}

// Fetch experiences from WordPress CPT
let experiencesData: any[] = [];
try {
  const expUrl = `${import.meta.env.API_URL}/experience?_embed`;
  const expResponse = await fetch(expUrl);

  if (expResponse.ok && expResponse.headers.get('content-type')?.includes('application/json')) {
    experiencesData = await expResponse.json();
    console.log('Experiencias:', experiencesData.length);
  }
} catch (error) {
  console.log('No se pudieron cargar las experiencias');
}

let subtitle = "";
let description = "";
let imageUrl = "";
let imageWidth = 0;
let imageHeight = 0;
let studies: any[] = [];
let experiences: any[] = [];
let certificates: any[] = [];

if (parsedData) {
  if (
    parsedData.acf &&
    !Array.isArray(parsedData.acf) &&
    parsedData.acf.title
  ) {
    title = parsedData.acf.title;
  }

  if (
    parsedData.acf &&
    !Array.isArray(parsedData.acf) &&
    parsedData.acf.subtititle
  ) {
    description = parsedData.acf.subtititle;
  }

  // Intentar primero desde ACF image
  if (
    parsedData.acf &&
    !Array.isArray(parsedData.acf) &&
    parsedData.acf.image &&
    typeof parsedData.acf.image === "object" &&
    "full" in parsedData.acf.image
  ) {
    imageUrl = parsedData.acf.image.full.url;
    imageWidth = parsedData.acf.image.full.width;
    imageHeight = parsedData.acf.image.full.height;
  }

  // Si no hay imagen en ACF, usar featured_images
  if (
    !imageUrl &&
    parsedData.featured_images &&
    typeof parsedData.featured_images === "object" &&
    "full" in parsedData.featured_images
  ) {
    imageUrl = parsedData.featured_images.full.url;
    imageWidth = parsedData.featured_images.full.width;
    imageHeight = parsedData.featured_images.full.height;
  }

  // Procesar estudios
  if (parsedData.acf && !Array.isArray(parsedData.acf)) {
    for (let i = 1; i <= 10; i++) {
      const studyKey = `study_${i}` as keyof typeof parsedData.acf;
      const study = parsedData.acf[studyKey];

      if (study && typeof study === "object" && "career" in study && study.career) {
        const studyData: any = {
          id: i,
          title: study.career,
          institution: study.institution || "",
          period: study.date_from && study.date_until
            ? `${study.date_from} - ${study.date_until}`
            : "",
          status: study.complete === true ? "Completado" : "En curso",
          description: "",
        };

        // Usar imagen de la institución para la card
        if (study.img_institution && typeof study.img_institution === "object" && "full" in study.img_institution) {
          studyData.image = study.img_institution.full.url;
        }

        // Usar certificado como URL del botón "Ver Certificado"
        if (study.certificate && typeof study.certificate === "object" && "full" in study.certificate) {
          studyData.certificateUrl = study.certificate.full.url;
        }

        studies.push(studyData);
      }
    }
  }

  // Procesar experiencias desde campos ACF de la página (legacy - fallback)
  if (parsedData.acf && !Array.isArray(parsedData.acf)) {
    for (let i = 1; i <= 10; i++) {
      const expKey = `experience_${i}` as keyof typeof parsedData.acf;
      const exp = parsedData.acf[expKey];

      if (exp && typeof exp === "object" && "title" in exp && exp.title) {
        const expData: any = {
          id: i,
          company: exp.title,
          description: exp.description || "",
          period: exp.experience_time || "",
        };

        // Usar imagen de la empresa para la card
        if (exp.img && typeof exp.img === "object" && "full" in exp.img) {
          expData.image = exp.img.full.url;
        }

        experiences.push(expData);
      }
    }
  }
}

// Procesar experiencias desde CPT (dinámico - preferido)
if (experiencesData && experiencesData.length > 0) {
  experiences = experiencesData.map((exp: any, index: number) => {
    const expData: any = {
      id: exp.id,
      company: exp.title.rendered,
      description: exp.acf?.description || exp.content?.rendered?.replace(/<[^>]*>/g, '') || "",
      period: exp.acf?.experience_time || "",
    };

    // Usar imagen ACF si está disponible
    if (exp.acf?.img && typeof exp.acf.img === "object" && "full" in exp.acf.img) {
      expData.image = exp.acf.img.full.url;
    }
    // Fallback a featured image
    else if (exp.featured_images && typeof exp.featured_images === "object" && "full" in exp.featured_images) {
      expData.image = exp.featured_images.full.url;
    }

    return expData;
  });
}

// Procesar certificados desde ACF
if (parsedData && parsedData.acf && !Array.isArray(parsedData.acf)) {
  for (let i = 1; i <= 20; i++) {
    const certKey = `certificate_${i}` as keyof typeof parsedData.acf;
    const cert = parsedData.acf[certKey];

    if (cert && typeof cert === "object" && "name" in cert && cert.name) {
      const certData: any = {
        id: i,
        name: cert.name,
      };

      // Usar imagen del certificado
      if (cert.img && typeof cert.img === "object" && "full" in cert.img) {
        certData.image = cert.img.full.url;
      }

      certificates.push(certData);
    }
  }
}
---

<Layout title={title}>
  <HeroSection
    title={title}
    subtitle={subtitle}
    description={description}
    imageUrl={imageUrl}
    imageWidth={imageWidth}
    imageHeight={imageHeight}
  />
  <StudiesSection studies={studies} />
  <CertificatesSection certificates={certificates} />
  <ExperienceSection experiences={experiences} />
  <TestimonialsSection />
  <TechnologiesSection />
  <ContactSection />
</Layout>
