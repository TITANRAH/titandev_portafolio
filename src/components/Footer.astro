---
import { NAV_ITEMS, SOCIAL_LINKS, SITE_TITLE } from "../constants";

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-tech-dark border-t border-tech-cyan/20">
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(0, 212, 255, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 212, 255, 0.1) 1px, transparent 1px); background-size: 50px 50px;"
    >
    </div>
  </div>

  <div class="relative z-10 container mx-auto px-6 py-12">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8"
      data-aos="fade-up"
    >
      <div class="lg:col-span-1">
        <a href="#home" class="inline-block mb-4">
          <h3
            class="text-2xl font-black bg-linear-to-r from-tech-cyan to-tech-green bg-clip-text text-transparent"
          >
            TitanDev
          </h3>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          Desarrollador Full-Stack especializado en crear soluciones web
          modernas y eficientes.
        </p>
        <div class="flex gap-4">
          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center rounded-full border-2 border-tech-cyan/50 text-tech-cyan hover:bg-tech-cyan hover:text-tech-black transition-all duration-300 hover:scale-110"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
          </a>
          <a
            href={`mailto:${SOCIAL_LINKS.email}`}
            class="w-10 h-10 flex items-center justify-center rounded-full border-2 border-tech-green/50 text-tech-green hover:bg-tech-green hover:text-tech-black transition-all duration-300 hover:scale-110"
            aria-label="Email"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-tech-cyan font-bold text-lg mb-4">Navegación</h4>
        <ul class="space-y-3">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-gray-400 hover:text-tech-cyan transition-colors duration-300 text-sm flex items-center gap-2 group"
                >
                  <span class="w-0 group-hover:w-2 h-0.5 bg-tech-cyan transition-all duration-300" />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-tech-green font-bold text-lg mb-4">Enlaces Rápidos</h4>
        <ul class="space-y-3">
          <li>
            <a
              href="#experiencia"
              class="text-gray-400 hover:text-tech-green transition-colors duration-300 text-sm flex items-center gap-2 group"
            >
              <span
                class="w-0 group-hover:w-2 h-0.5 bg-tech-green transition-all duration-300"
              ></span>
              Experiencia Laboral
            </a>
          </li>
          <li>
            <a
              href="#estudios"
              class="text-gray-400 hover:text-tech-green transition-colors duration-300 text-sm flex items-center gap-2 group"
            >
              <span
                class="w-0 group-hover:w-2 h-0.5 bg-tech-green transition-all duration-300"
              ></span>
              Formación Académica
            </a>
          </li>
          <li>
            <a
              href="#stack-tecnico"
              class="text-gray-400 hover:text-tech-green transition-colors duration-300 text-sm flex items-center gap-2 group"
            >
              <span
                class="w-0 group-hover:w-2 h-0.5 bg-tech-green transition-all duration-300"
              ></span>
              Tecnologías
            </a>
          </li>
          <li>
            <a
              href="#contacto"
              class="text-gray-400 hover:text-tech-green transition-colors duration-300 text-sm flex items-center gap-2 group"
            >
              <span
                class="w-0 group-hover:w-2 h-0.5 bg-tech-green transition-all duration-300"
              ></span>
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-tech-purple font-bold text-lg mb-4">Contacto</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-tech-purple mt-0.5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href={`mailto:${SOCIAL_LINKS.email}`}
              class="text-gray-400 hover:text-tech-purple transition-colors duration-300 text-sm"
            >
              {SOCIAL_LINKS.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-tech-purple mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
            <a
              href={SOCIAL_LINKS.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-tech-purple transition-colors duration-300 text-sm"
            >
              LinkedIn Profile
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-tech-cyan/20 pt-8 mt-8"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-gray-500 text-sm text-center md:text-left">
          © {currentYear}
          <span class="text-tech-cyan font-semibold">TitanDev</span>. Todos los
          derechos reservados.
        </p>
        <div class="flex items-center gap-2 text-gray-500 text-sm">
          <span>Hecho con</span>
          <svg
            class="w-4 h-4 text-red-500 animate-pulse"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            ></path>
          </svg>
          <span>y</span>
          <span class="text-tech-cyan font-semibold">Astro</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    position: relative;
  }

  /* Smooth scroll for footer links */
  footer a[href^="#"] {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Smooth scroll for footer navigation links
  document.querySelectorAll('footer a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", (e) => {
      e.preventDefault();
      const href = anchor.getAttribute("href");
      const target = href ? document.querySelector(href) : null;
      if (target) {
        target.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    });
  });
</script>
